# Global Configuration
RESTART_POLICY=always
TIMEZONE=Asia/Bangkok
HEALTHCHECK_INTERVAL=10s
HEALTHCHECK_TIMEOUT=5s
HEALTHCHECK_RETRIES=5

# Network Configuration
NETWORK_NAME=shlink_network

# Postgres Configuration
POSTGRES_CONTAINER_NAME=shlink_db
POSTGRES_VERSION=15
POSTGRES_VOLUME_NAME=shlink_postgres_data
POSTGRES_PORT=5432
POSTGRES_USER=shlink
POSTGRES_PASSWORD=shlink_password
POSTGRES_DB=shlink

# Shlink Configuration
SHLINK_CONTAINER_NAME=shlink_app
SHLINK_VERSION=stable
SHLINK_VOLUME_NAME=shlink_data
SHLINK_PORT=8080
SHLINK_API_KEY=your_api_key_here

# Web Client Configuration
SHLINK_WEB_CONTAINER_NAME=shlink_web
SHLINK_WEB_VERSION=latest
SHLINK_WEB_HTTP_PORT=80
SHLINK_WEB_HTTPS_PORT=443

# Domain Configuration
HOST_ADDR=localhost
DDNS_ADDR=example.com